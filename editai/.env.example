# =====================================================================
# EDITAI — variáveis de ambiente
# Copie para .env.local e preencha. NUNCA comite secrets.
# =====================================================================

# --- App -------------------------------------------------------------
# Opcional. Sem ela, o app usa o domínio da própria requisição.
NEXT_PUBLIC_APP_URL=

# --- Supabase (obrigatório) -----------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente servidor/worker. Nunca exponha no browser.
SUPABASE_SERVICE_ROLE_KEY=
# Bucket privado onde ficam vídeos, áudios, versões e exports.
SUPABASE_STORAGE_BUCKET=editai-media

# --- IA: planejador de edição (LLM) ---------------------------------
# anthropic | openai | rules
#   rules = planejador determinístico local (sem LLM). Funciona, mas entende
#   apenas os comandos mapeados em services/ai/planner/rule-based-planner.ts.
AI_PROVIDER=anthropic
AI_API_KEY=
# Modelo usado pelo provedor escolhido.
AI_MODEL=claude-opus-5-5

# --- Speech-to-Text --------------------------------------------------
# openai | browser
#   openai  = Whisper (servidor, com timestamps por palavra p/ legendas e zoom)
#   browser = sem provedor no servidor: usa a transcrição feita pelo navegador
#             (Web Speech API). Não gera timestamps do vídeo → legendas/zoom por
#             palavra ficam indisponíveis e o usuário é avisado.
STT_PROVIDER=openai
SPEECH_TO_TEXT_API_KEY=
STT_MODEL=whisper-1
STT_LANGUAGE=pt

# --- Processamento / FFmpeg ------------------------------------------
# true  = o próprio app processa os vídeos (rota /api/jobs/run) — ideal na Vercel.
# false = use um worker dedicado (`npm run worker`) com FFmpeg instalado.
INLINE_JOBS=true
# Opcional: binários do sistema. Sem isso, usa o ffmpeg-static empacotado
# (e lê metadados pelo próprio ffmpeg quando não há ffprobe).
FFMPEG_PATH=
FFPROBE_PATH=
# Opcional: pasta de fontes do libass (padrão: assets/fonts, com Inter).
FONTS_DIR=
WORKER_POLL_INTERVAL_MS=2000
WORKER_TMP_DIR=
WORKER_CONCURRENCY=1

# --- Limites ---------------------------------------------------------
# Plano grátis do Supabase: máximo de 50 MB por arquivo.
MAX_UPLOAD_MB=50
MAX_VIDEO_SECONDS=900

# --- Pagamentos (opcional) ------------------------------------------
# stripe | none   (none = checkout desabilitado, UI mostra aviso)
PAYMENT_PROVIDER=none
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
